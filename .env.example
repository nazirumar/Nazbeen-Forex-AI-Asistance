# Nazbeen Forex AI Asistance — environment configuration template
# Copy to `.env` and fill in values. `.env` is git-ignored — NEVER commit real secrets.
# All timestamps internally are UTC.

# --- Django core ---
# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database ---
# SQLite by default (development). PostgreSQL example:
# DATABASE_URL=postgres://nazbeen:nazbeen@localhost:5432/nazbeen_forex
DATABASE_URL=

# --- Application ---
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Log output: "text" (key=value lines, default) or "json" (one JSON object per
# line — recommended in production). Secrets are redacted in both formats.
LOG_FORMAT=text

# --- LLM providers (Phase 11B) ---
# Explicit mock switch. true = labeled mock providers (no network, no keys) —
# the automated suite always runs in mock mode. false = the real providers below
# are used; failures are surfaced to the caller and NEVER silently mocked.
USE_MOCK_LLM=true
# Vision-capable model used for screenshot inspection.
# Provider values: "openai" or "gemini".
VISION_LLM_PROVIDER=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=
# Text reasoning model used for explanations/scenarios.
REASONING_LLM_PROVIDER=
REASONING_LLM_API_KEY=
REASONING_LLM_MODEL=
# Transport hardening: per-attempt timeout (seconds), retries for 429/5xx/timeouts,
# and the exponential-backoff base between retries.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1

# --- MT5 worker (Phase 3) ---
# URL of the Windows-hosted MT5 connector worker.
MT5_WORKER_URL=
MT5_WORKER_TOKEN=
# Set to "true" only in development when no MT5 terminal is available.
# Mock data is always labeled as mock in API responses.
MT5_USE_MOCK=false

# --- Backend services (Phase 10) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Run Celery tasks in-process so the dashboard works without a running worker.
# Only ever enabled in development; production forces this off.
CELERY_TASK_ALWAYS_EAGER=true
# WebSocket channel layer: false = in-memory (single process, dev/test),
# true = Redis-backed (multi-process/production, needs REDIS_URL).
USE_REDIS_CHANNELS=false

# --- CORS (frontend dev server) ---
# Next.js dev runs on port 3000; the dashboard calls the backend directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting (DRF) ---
# Login/register use the tighter "auth" rate. Tune per environment.
THROTTLE_RATE_ANON=60/min
THROTTLE_RATE_USER=600/min
THROTTLE_RATE_AUTH=10/min

# --- Trading risk defaults (Phase 5, analysis-only) ---
RISK_PER_TRADE_PERCENT=1.0
MAX_SPREAD_POINTS=2.0
MIN_RISK_REWARD=2.0
